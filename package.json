{
  "name": "roc",
  "version": "0.1.0",
  "description": "Roc",
  "author": "ryz",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:agent:integration": "vitest run --config vitest.agent-integration.config.ts",
    "eval:agent": "node scripts/run-agent-eval.mjs",
    "test:watch": "vitest",
    "generate:ipc": "node scripts/generate-ipc-schema.mjs",
    "check:ipc": "node scripts/generate-ipc-schema.mjs --check",
    "check:renderer-chunks": "node scripts/check-renderer-chunks.mjs",
    "database:backup": "node dist/main/database-maintenance-cli.js backup",
    "database:restore": "node dist/main/database-maintenance-cli.js restore",
    "package:dir": "node scripts/package-dir.mjs",
    "smoke:agent-performance": "vitest run --config vitest.agent-performance.config.ts",
    "smoke:performance": "node scripts/smoke-performance.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "verify:native-packaging": "node scripts/verify-native-packaging.mjs",
    "verify:paths": "node scripts/verify-paths.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.1",
    "@langchain/core": "1.2.8",
    "@langchain/langgraph": "1.4.10",
    "@langchain/mcp-adapters": "1.1.3",
    "@langchain/openai": "1.5.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "12.11.1",
    "deepagents": "1.12.4",
    "highlight.js": "11.11.1",
    "langchain": "1.5.9",
    "lucide-react": "1.24.0",
    "motion": "12.42.2",
    "node-pty": "1.1.0",
    "react": "19.2.7",
    "react-diff-view": "3.3.3",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-virtuoso": "4.18.10",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "streamdown": "2.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.61.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "42.6.1",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.1",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  }
}
