{
  "name": "roc",
  "version": "0.1.0",
  "description": "Roc",
  "author": "ryz",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "dev": "node scripts/dev-electron.mjs",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "harness:eval": "node scripts/harness-eval/run.mjs",
    "test": "pnpm test:unit && pnpm test:renderer && node scripts/smoke-electron.mjs",
    "test:unit": "node --test tests/unit/",
    "test:renderer": "node --test tests/renderer/",
    "generate:ipc": "node scripts/generate-ipc-schema.mjs",
    "check:ipc": "node scripts/generate-ipc-schema.mjs --check",
    "check:renderer-chunks": "node scripts/check-renderer-chunks.mjs",
    "report:renderer-eager": "node scripts/report-renderer-eager-modules.mjs",
    "verify:p3-workspace": "node scripts/verify-p3-workspace.mjs",
    "verify:p4-assistant": "node scripts/verify-p4-assistant.mjs",
    "verify:p5-literature": "node scripts/verify-p5-literature.mjs",
    "verify:p8-settings": "node scripts/verify-p8-settings.mjs",
    "verify:p9-management": "node scripts/verify-p9-management.mjs",
    "database:backup": "node dist/main/database-maintenance-cli.js backup",
    "database:restore": "node dist/main/database-maintenance-cli.js restore",
    "database:migrate": "node scripts/migrate-databases.mjs",
    "database:clear-agent-history": "node scripts/clear-agent-history.mjs --all-thread-kinds",
    "logs:query": "node scripts/query-logs.mjs",
    "audit:layout": "node scripts/ui-layout-audit.mjs",
    "package:dir": "node scripts/package-dir.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "smoke:mac": "node scripts/smoke-mac.mjs",
    "smoke:performance": "node scripts/smoke-performance.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs --full",
    "verify:native-packaging": "node scripts/verify-native-packaging.mjs",
    "verify:arm64-only": "node scripts/verify-arm64-only.mjs",
    "verify:paths": "node scripts/verify-paths.mjs",
    "sync:builtin-skills": "node scripts/sync-builtin-skills.mjs",
    "sync:ripgrep": "node scripts/fetch-ripgrep.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.13",
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.2",
    "@langchain/mcp-adapters": "2.0.1",
    "@langchain/openai": "1.6.3",
    "@napi-rs/canvas": "1.0.13",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "d3-dsv": "3.0.1",
    "deepagents": "1.15.1",
    "fast-xml-parser": "5.11.2",
    "htmlparser2": "12.0.0",
    "js-tiktoken": "1.0.21",
    "langchain": "1.5.18",
    "node-pty": "1.1.0",
    "onnxruntime-node": "1.22.0-rev",
    "paddleocr": "1.2.0",
    "pdfjs-dist": "6.4.299",
    "shell-env": "4.0.3",
    "simple-statistics": "7.12.1",
    "sqlite-vec": "0.1.9",
    "utif": "3.1.0",
    "vega": "6.2.0",
    "vega-lite": "6.4.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "0.1.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/utif": "3.0.6",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "lucide-react": "1.61.0",
    "motion": "14.5.0",
    "react": "19.3.1",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-virtuoso": "4.18.19",
    "remark-gfm": "4.0.1",
    "streamdown": "2.7.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
