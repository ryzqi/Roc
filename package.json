{
  "name": "roc",
  "version": "0.1.0",
  "description": "Roc",
  "author": "ryz",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "dev": "node scripts/dev-electron.mjs",
    "build": "pnpm check:skills && pnpm typecheck && electron-vite build && pnpm check:renderer-chunks",
    "check:skills": "node scripts/check-research-skills.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "evaluate": "node evaluation/lib/cli.mjs",
    "evaluation:check": "node --test --test-concurrency=2 evaluation/tests/",
    "evaluation:scientific-rag:check": "node scripts/check-scientific-rag-corpus.mjs",
    "evaluation:native:check": "node evaluation/adapters/native/run.mjs",
    "evaluation:s01:check": "node evaluation/lib/cli.mjs check --suite roc-s01",
    "evaluation:s01:prepare-worker": "node evaluation/adapters/s01/prepare-worker.mjs",
    "evaluation:frozen-retrieval:check": "node evaluation/lib/cli.mjs check --suite frozen-retrieval",
    "research:retrieval-eval": "node scripts/evaluate-literature-retrieval.mjs",
    "research:acquisition-eval": "node scripts/evaluate-literature-acquisition.mjs",
    "research:literature-capture": "node scripts/capture-literature-public.mjs",
    "test:literature-acquisition": "node --test tests/unit/literature-query-planner.test.mjs tests/unit/literature-domain-sources.test.mjs tests/unit/literature-import.test.mjs tests/unit/literature-pdf-acquisition.test.mjs tests/unit/pdf-source-resolver.test.mjs tests/unit/literature-acquisition-evaluation.test.mjs tests/unit/literature-retrieval-evaluation.test.mjs",
    "research:retrieval-bench": "node scripts/benchmark-research-retrieval.mjs",
    "research:network-bench": "node scripts/benchmark-research-network.mjs",
    "research:storage-bench": "node scripts/benchmark-research-storage.mjs",
    "research:admission-bench": "node scripts/benchmark-research-admission.mjs",
    "research:graph-bench": "node scripts/benchmark-research-graph.mjs",
    "harness:resource-bench": "node evaluation/adapters/native/resource-admission-bench.mjs",
    "test": "pnpm test:unit && pnpm test:renderer && node scripts/smoke-electron.mjs",
    "test:unit": "node --test tests/unit/",
    "test:renderer": "node --test --test-concurrency=1 tests/renderer/",
    "test:research-p0": "pnpm build && node scripts/run-research-p0.mjs",
    "test:review-workflow": "node --test tests/integration/research-review-workflow.test.mjs",
    "test:research-resources": "node --test tests/integration/research-process-guard.test.mjs tests/integration/research-process-resources.test.mjs",
    "test:research-environment-boundaries": "node --test tests/integration/research-python-environment.test.mjs tests/integration/research-python-process.test.mjs",
    "test:research-native-code": "node --test tests/unit/research-native-code.test.mjs tests/integration/research-python-experiments.test.mjs",
    "generate:ipc": "node scripts/generate-ipc-schema.mjs",
    "check:ipc": "node scripts/generate-ipc-schema.mjs --check",
    "check:renderer-chunks": "node scripts/check-renderer-chunks.mjs",
    "check:mac-performance-release": "node scripts/performance/check-macos-release.mjs",
    "check:mac-rollback": "node scripts/performance/drill-macos-rollback.mjs",
    "report:renderer-eager": "node scripts/report-renderer-eager-modules.mjs",
    "verify:p3-workspace": "node scripts/verify-p3-workspace.mjs",
    "verify:p4-assistant": "node scripts/verify-p4-assistant.mjs",
    "verify:p5-literature": "node scripts/verify-p5-literature.mjs",
    "verify:p8-settings": "node scripts/verify-p8-settings.mjs",
    "verify:p9-management": "node scripts/verify-p9-management.mjs",
    "database:backup": "node dist/main/database-maintenance-cli.js backup",
    "database:restore": "node dist/main/database-maintenance-cli.js restore",
    "database:clear-agent-history": "node scripts/clear-agent-history.mjs --all-thread-kinds",
    "logs:query": "node scripts/query-logs.mjs",
    "audit:design": "python3 scripts/ui-audit/audit-design-rules.py src/renderer",
    "audit:motion": "node scripts/ui-audit/audit-motion-rules.mjs src/renderer",
    "audit:layout": "node scripts/ui-layout-audit.mjs",
    "package:dir": "node scripts/package-dir.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "release:mac": "node scripts/release-mac.mjs",
    "smoke:mac": "node scripts/smoke-mac.mjs",
    "smoke:performance": "node scripts/smoke-performance.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs --full",
    "verify:native-packaging": "node scripts/verify-native-packaging.mjs",
    "verify:arm64-only": "node scripts/verify-arm64-only.mjs",
    "verify:paths": "node scripts/verify-paths.mjs",
    "sync:builtin-skills": "node scripts/sync-builtin-skills.mjs",
    "sync:ripgrep": "node scripts/fetch-ripgrep.mjs",
    "harness:bench": "node evaluation/lib/cli.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.6.5",
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/openai": "1.8.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@napi-rs/canvas": "1.1.1",
    "@retorquere/bibtex-parser": "14.0.6",
    "better-sqlite3": "13.2.0",
    "croner": "11.0.1",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "deepagents": "1.17.0",
    "fast-xml-parser": "5.12.1",
    "htmlparser2": "12.0.0",
    "js-tiktoken": "1.0.21",
    "langchain": "1.6.6",
    "node-pty": "1.1.0",
    "onnxruntime-node": "1.31.1",
    "p-retry": "9.0.0",
    "paddleocr": "1.2.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pino": "10.4.0",
    "shell-env": "4.0.3",
    "simple-statistics": "8.0.0",
    "sqlite-vec": "0.1.9",
    "utif": "3.1.0",
    "vega": "6.4.0",
    "vega-lite": "6.5.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "0.1.9"
  },
  "devDependencies": {
    "@babel/parser": "8.1.2",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.65.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tiptap/extension-mathematics": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/utif": "3.0.6",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "lowlight": "3.3.0",
    "lucide-react": "1.75.0",
    "mermaid": "12.3.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-virtuoso": "4.18.23",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "streamdown": "2.8.0",
    "swr": "2.5.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "zustand": "5.1.0"
  }
}
