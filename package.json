{
  "name": "roc",
  "version": "0.1.0",
  "description": "Roc",
  "author": "ryz",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "dev": "node scripts/dev-electron.mjs",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:agent:integration": "vitest run --config vitest.agent-integration.config.ts",
    "eval:agent": "node scripts/run-agent-eval.mjs",
    "test:watch": "vitest",
    "generate:ipc": "node scripts/generate-ipc-schema.mjs",
    "check:ipc": "node scripts/generate-ipc-schema.mjs --check",
    "check:renderer-chunks": "node scripts/check-renderer-chunks.mjs",
    "database:backup": "node dist/main/database-maintenance-cli.js backup",
    "database:restore": "node dist/main/database-maintenance-cli.js restore",
    "package:dir": "node scripts/package-dir.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "smoke:mac": "node scripts/smoke-mac.mjs",
    "smoke:agent-performance": "vitest run --config vitest.agent-performance.config.ts",
    "smoke:performance": "node scripts/smoke-performance.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "verify:native-packaging": "node scripts/verify-native-packaging.mjs",
    "verify:paths": "node scripts/verify-paths.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.10",
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.16",
    "@langchain/mcp-adapters": "1.1.4",
    "@langchain/openai": "1.5.13",
    "@napi-rs/canvas": "1.0.9",
    "better-sqlite3": "13.0.3",
    "deepagents": "1.14.0",
    "fast-xml-parser": "5.11.1",
    "langchain": "1.5.11",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.3.289",
    "shell-env": "4.0.3",
    "sqlite-vec": "0.1.9",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "0.1.9",
    "sqlite-vec-darwin-x64": "0.1.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.16.1",
    "electron-vite": "6.0.0-beta.1",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "highlight.js": "11.12.0",
    "jsdom": "30.1.0",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "react": "19.3.0",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-virtuoso": "4.18.14",
    "remark-gfm": "4.0.1",
    "streamdown": "2.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
