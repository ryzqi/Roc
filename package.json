{
  "name": "roc",
  "version": "0.1.0",
  "description": "Roc",
  "author": "ryz",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:ipc": "node scripts/generate-ipc-schema.mjs",
    "check:ipc": "node scripts/generate-ipc-schema.mjs --check",
    "package:dir": "node scripts/package-dir.mjs",
    "smoke:performance": "node scripts/smoke-performance.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "verify:native-packaging": "node scripts/verify-native-packaging.mjs",
    "verify:paths": "node scripts/verify-paths.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.1",
    "@langchain/core": "1.2.1",
    "@langchain/langgraph": "1.4.4",
    "@langchain/mcp-adapters": "1.1.3",
    "@langchain/openai": "^1.5.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "12.11.1",
    "deepagents": "1.10.5",
    "highlight.js": "11.11.1",
    "langchain": "1.5.1",
    "langsmith": "0.7.10",
    "lucide-react": "1.21.0",
    "motion": "12.40.0",
    "node-pty": "1.1.0",
    "react": "19.2.7",
    "react-diff-view": "3.3.3",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "streamdown": "2.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.4",
    "@playwright/test": "1.61.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.9",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "5.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  }
}
