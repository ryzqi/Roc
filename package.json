{
  "name": "roc-windows-super-assistant",
  "version": "0.1.0",
  "description": "Roc Windows local desktop assistant",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:dir": "node scripts/package-dir.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "verify:native-packaging": "node scripts/verify-native-packaging.mjs",
    "verify:paths": "node scripts/verify-paths.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.3.29",
    "@langchain/core": "1.1.45",
    "@langchain/langgraph": "1.3.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/mcp-adapters": "1.1.3",
    "@langchain/openai": "^1.4.5",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "12.9.0",
    "clsx": "2.1.1",
    "deepagents": "1.10.0",
    "highlight.js": "11.10.0",
    "langchain": "1.4.0",
    "langsmith": "0.5.25",
    "lucide-react": "1.11.0",
    "motion": "12.38.0",
    "node-pty": "1.1.0",
    "react": "19.2.5",
    "react-diff-view": "3.3.3",
    "react-dom": "19.2.5",
    "react-markdown": "9.0.1",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.4",
    "@playwright/test": "1.59.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.3.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "7.3.2",
    "vitest": "4.1.5",
    "wait-on": "9.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  }
}
